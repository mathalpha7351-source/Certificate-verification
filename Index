<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Verification System</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f2f2f2;
      padding: 20px;
    }
    .container {
      max-width: 500px;
      margin: auto;
      background: #fff;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    input, select {
      width: 100%;
      padding: 10px;
      margin: 8px 0;
      border-radius: 5px;
      border: 1px solid #ccc;
    }
    button {
      width: 100%;
      padding: 12px;
      background: #007bff;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-size: 16px;
    }
    #result {
      margin-top: 20px;
      padding: 15px;
      background: #e7ffe7;
      border-left: 5px solid green;
      display: none;
    }
    .code-box {
      background: #000;
      color: #0f0;
      padding: 10px;
      border-radius: 5px;
      margin-top: 10px;
      font-family: monospace;
      font-size: 14px;
      white-space: pre-wrap;
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>Student Verification Form</h2>

    <form id="studentForm">
      <label>Student Name</label>
      <input type="text" id="studentName" required />

      <label>Father Name</label>
      <input type="text" id="fatherName" required />

      <label>Course</label>
      <input type="text" id="course" required />

      <label>Grade</label>
      <input type="text" id="grade" required />

      <label>Registration Number</label>
      <input type="text" id="regNo" required />

      <button type="submit">Generate Verification Code</button>
    </form>

    <div id="result">
      <h3>Verification Code Generated:</h3>
      <div class="code-box" id="codeBox"></div>
    </div>
  </div>

  <script>
    document.getElementById("studentForm").addEventListener("submit", function(e){
      e.preventDefault();

      let name = document.getElementById("studentName").value.trim().toUpperCase();
      let father = document.getElementById("fatherName").value.trim().toUpperCase();
      let course = document.getElementById("course").value.trim().toUpperCase();
      let grade = document.getElementById("grade").value.trim().toUpperCase();
      let reg = document.getElementById("regNo").value.trim().toUpperCase();

      let uniqueCode = btoa(name + "|" + father + "|" + course + "|" + grade + "|" + reg);

      document.getElementById("result").style.display = "block";
      document.getElementById("codeBox").innerText = uniqueCode;
    });
  </script>
</body>
</html>
